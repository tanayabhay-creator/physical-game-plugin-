{
  "name": "physical-media-launcher",
  "version": "1.0.1",
  "description": "Decky plugin that auto-detects game SD/USB media, copies to SSD, adds Non-Steam shortcuts, and launches.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python3 -m unittest discover -s tests -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanayabhay-creator/physical-game-plugin-.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "sd-card",
    "non-steam"
  ],
  "author": "Physical Media Launcher Contributors",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
